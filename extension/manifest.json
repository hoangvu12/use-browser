{
  "manifest_version": 3,
  "name": "use-browser bridge",
  "version": "0.9.0",
  "description": "Lets the use-browser CLI drive this browser, with your logins, through chrome.debugger. Click the icon to turn it off.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "use-browser bridge" }
}
